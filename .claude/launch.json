{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dot-line-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "site-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8091",
        "--bind",
        "127.0.0.1",
        "--directory",
        "_site"
      ],
      "port": 8091
    }
  ]
}