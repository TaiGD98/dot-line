{
  "name": "dot-line",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:site": "bash scripts/build-site.sh",
    "release": "bash scripts/release.sh",
    "release:latest": "bash scripts/release.sh latest",
    "build:editor": "tsc --noEmit && vite build --config vite.editor.config.ts",
    "editor": "vite --open /editor/",
    "levels:intro": "esbuild tools/intro-levels.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/intro-levels.mjs --log-level=warning && node node_modules/.cache/intro-levels.mjs",
    "art": "esbuild tools/export-art.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/export-art.mjs --log-level=warning && node node_modules/.cache/export-art.mjs",
    "levels:build": "esbuild tools/build-levels.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-levels.mjs --log-level=warning && node node_modules/.cache/build-levels.mjs",
    "art:measure": "esbuild tools/measure-art.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/measure-art.mjs --log-level=warning && node node_modules/.cache/measure-art.mjs",
    "levels:chapter3": "esbuild tools/build-chapter3.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-chapter3.mjs --log-level=warning && node node_modules/.cache/build-chapter3.mjs",
    "levels:import-ref": "esbuild tools/import-ref.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/import-ref.mjs --log-level=warning && node node_modules/.cache/import-ref.mjs",
    "levels:chapter4": "esbuild tools/build-chapter4.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-chapter4.mjs --log-level=warning && node node_modules/.cache/build-chapter4.mjs",
    "levels:chapter5": "esbuild tools/build-chapter5.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-chapter5.mjs --log-level=warning && node node_modules/.cache/build-chapter5.mjs",
    "publish:levels": "esbuild tools/publish-levels.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/publish-levels.mjs --log-level=warning && node node_modules/.cache/publish-levels.mjs",
    "art:magic": "bash tools/magic-art.sh",
    "levels:chapter6": "esbuild tools/build-chapter6.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-chapter6.mjs --log-level=warning && node node_modules/.cache/build-chapter6.mjs",
    "art:fluffy": "esbuild tools/fluffy-art.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/fluffy-art.mjs --log-level=warning && node node_modules/.cache/fluffy-art.mjs",
    "art:ui": "esbuild tools/ui-art.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ui-art.mjs --log-level=warning && node node_modules/.cache/ui-art.mjs"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4"
  }
}
